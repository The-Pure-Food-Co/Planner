# Shared AUTH project (purefoods-planner's Supabase project, ref rzenewwvbtxadhhgzrnf).
# Every internal app points its Supabase Auth client at THIS SAME project/anon key so
# sessions minted by the hub are valid here too — a session is just a JWT signed by
# whichever project issued it, so pointing this at a different project would make
# setSession() in app/auth/callback silently fail signature validation. Copy these
# values from an existing internal app's .env (e.g. purefoods-planner or
# forecast-product) — this app's own tables (workspaces, tasks, etc.) also live in
# this same project, see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared org SSO app every internal app redirects to when there's no session.
# Every app points at the same hub — do not change unless you're standing up a new hub.
NEXT_PUBLIC_AUTH_HUB_URL=https://purefoods-planner.vercel.app
